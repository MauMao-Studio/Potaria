/assets/walls/*.meta

# Legacy root assets metadata exclusions
/assets/*.meta
!/assets/Audio.meta
!/assets/Data.meta
!/assets/ScriptableObjects.meta
!/assets/Scripts.meta
!/assets/Sprites.meta
!/assets/*.asset.meta
